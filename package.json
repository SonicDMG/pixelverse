{
  "name": "pixelticker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n next,sidecar -c cyan,magenta \"next dev\" \"sidecar/.venv/bin/uvicorn sidecar.main:app --port 7421\"",
    "dev:next": "next dev",
    "dev:sidecar": "sidecar/.venv/bin/uvicorn sidecar.main:app --port 7421",
    "setup:sidecar": "python3 -m venv sidecar/.venv && sidecar/.venv/bin/pip install -r sidecar/requirements.txt",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "axios": "^1.13.2",
    "better-sqlite3": "^13.0.3",
    "chart.js": "^4.5.1",
    "d3-geo": "^3.1.1",
    "d3-geo-projection": "^4.0.0",
    "d3-scale": "^4.0.2",
    "d3-time": "^3.1.0",
    "everart": "^1.2.2",
    "jsonrepair": "^3.13.2",
    "next": "16.1.6",
    "openai": "^7.8.0",
    "react": "19.2.3",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "19.2.3",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/preset-env": "^7.28.6",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.1",
    "@types/d3-geo": "^3.1.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-time": "^3.0.4",
    "@types/jest": "^29.5.11",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-jest": "^30.2.0",
    "concurrently": "^10.0.5",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jest": "^29.7.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^29.7.0",
    "msw": "^2.0.11",
    "tailwindcss": "^4",
    "ts-jest": "^29.1.1",
    "typescript": "^5",
    "web-audio-test-api": "^0.5.2"
  }
}
