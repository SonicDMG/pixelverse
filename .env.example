# PixelVerse Environment Configuration
# Copy this file to .env.local and configure with your actual values

# =============================================================================
# AUTHENTICATION (REQUIRED)
# =============================================================================

# Application authentication password (minimum 8 characters)
AUTH_PASSWORD=your_secure_password_here


# =============================================================================
# LLM CONFIGURATION (REQUIRED)
# =============================================================================

# OpenAI-compatible API key for the chat LLM
# Works with OpenAI, Azure OpenAI, watsonx, OpenRouter, Ollama (set LLM_BASE_URL)
LLM_API_KEY=your_llm_api_key_here

# LLM model name (default: gpt-4o-mini)
# LLM_MODEL=gpt-4o-mini

# Optional: override base URL for OpenAI-compatible providers
# LLM_BASE_URL=https://your-provider.com/v1


# =============================================================================
# EMBEDDING CONFIGURATION (REQUIRED for vector search)
# =============================================================================

# API key for the embedding model (can be the same as LLM_API_KEY)
EMBED_API_KEY=your_embed_api_key_here

# Embedding model name (default: text-embedding-3-small)
# EMBED_MODEL=text-embedding-3-small

# Optional: override base URL for embedding endpoint
# EMBED_BASE_URL=https://your-provider.com/v1


# =============================================================================
# RAG CORPUS DATABASE (REQUIRED)
# =============================================================================

# Path to the pre-built SQLite RAG corpus DB
# Build it once with: npx tsx scripts/ingest-corpus.ts
# Default: data/corpus.db (relative to project root)
# RAG_DB_PATH=data/corpus.db


# =============================================================================
# DOCLING SAAS (OPTIONAL — only needed when running ingest-corpus.ts)
# =============================================================================

# Docling SaaS endpoint for document parsing (used at ingest time only)
# If not set, ingest script falls back to plain-text DocLang stub
# DOCLING_API_URL=https://your-docling-instance.com
# DOCLING_API_KEY=your_docling_api_key_here


# =============================================================================
# EVERART IMAGE GENERATION (REQUIRED for celestial body image generation)
# =============================================================================

# EverArt API key for AI pixel-art image generation
EVERART_API_KEY=your_everart_api_key_here


# =============================================================================
# NODE ENVIRONMENT (OPTIONAL)
# =============================================================================

# NODE_ENV=development


# =============================================================================
# QUICK START
# =============================================================================
#
# 1. cp .env.example .env.local
# 2. Fill in LLM_API_KEY, EMBED_API_KEY, AUTH_PASSWORD, EVERART_API_KEY
# 3. Build the RAG corpus (once):
#      npx tsx scripts/ingest-corpus.ts --theme=space
# 4. Start the dev server:
#      npm run dev
#
# To use a local Ollama instance instead of OpenAI:
#   LLM_API_KEY=ollama
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.2
#   EMBED_API_KEY=ollama
#   EMBED_BASE_URL=http://localhost:11434/v1
#   EMBED_MODEL=nomic-embed-text

# Made with Bob
